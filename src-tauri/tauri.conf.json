{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Menu Runner",
  "version": "0.1.0",
  "identifier": "com.local.menurunner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Menu Runner", "width": 510, "height": 440, "visible": false, "resizable": false }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": { "resources/actions.json": "actions.json" },
    "icon": ["icons/menu-runner-template-v4.png"]
  }
}
