{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Menu Runner",
  "version": "0.1.4",
  "identifier": "com.local.menurunner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Menu Runner", "width": 510, "height": 440, "visible": false, "resizable": false }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": { "resources/actions.json": "actions.json" },
    "createUpdaterArtifacts": true,
    "icon": ["icons/menu-runner-template-v4.png"],
    "macOS": { "signingIdentity": "-" }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENCQjlENUMzQjg5NTY3NTQKUldSVVo1VzR3OVc1eThxUTZkbHVWUXBrS3BYSnNENkRlQ2w1dTFpUG1qOFhiUVE0ZjU1WVJYaUIK",
      "endpoints": ["https://github.com/prtkzxc/menu-runner/releases/latest/download/latest.json"]
    }
  }
}
